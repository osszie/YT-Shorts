# --- Content / LLM -----------------------------------------------------------
# Niche to generate for (config/niches/<id>.yaml). Default: hidden_things.
NICHE=hidden_things
# Google Gemini API key. Without it the pipeline still runs the "spine" using
# deterministic fallbacks (no grounding, no LLM angles/scripts).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=models/text-embedding-004
# Gemini client transport. Default "rest" works behind TLS-intercepting proxies
# (managed/corporate networks), where the gRPC default fails the TLS handshake.
# Set to "grpc" to use the library default.
GEMINI_TRANSPORT=rest
# Rate-limit handling: retry transient 429s with exponential backoff. The free
# tier's requests-per-minute is low; for real batches use a paid Gemini tier.
GEMINI_MAX_RETRIES=5
GEMINI_RETRY_BASE=2.0
GEMINI_RETRY_CAP=60.0

# --- Originality guard -------------------------------------------------------
# Cosine-similarity threshold above which a script is rejected & regenerated.
SIMILARITY_THRESHOLD=0.86

# --- Render ------------------------------------------------------------------
# Video assembly engine: remotion (motion-graphics, default) or ffmpeg.
# Remotion needs Node 18+ and `npm install` in ./remotion; if unavailable the
# pipeline automatically falls back to ffmpeg.
RENDER_ENGINE=remotion
REMOTION_FPS=30
# Optional: point Remotion at an existing Chrome instead of letting it download
# one (for hosts whose egress blocks remotion.media). When set, the engine uses
# --chrome-mode=chrome-for-testing (new headless), which a normal system/Chrome
# supports. Override the mode with REMOTION_CHROME_MODE=headless-shell if needed.
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome
# REMOTION_CHROME_MODE=chrome-for-testing

# --- Upload ------------------------------------------------------------------
# Dry-run by default so nothing publishes by accident. Set to false to upload.
YOUTUBE_DRY_RUN=true
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_MADE_FOR_KIDS=false
# Optional scheduled publish, hours from now (leave empty for immediate).
SCHEDULE_HOURS=
# OAuth files (relative to repo root).
YOUTUBE_CLIENT_SECRETS=credentials.json
YOUTUBE_TOKEN_FILE=token.json
